#REGION 0
REGIONAL m.currarea, m.talkstat, m.compstat

IF SET("TALK") = "ON"
	SET TALK OFF
	m.talkstat = "ON"
ELSE
	m.talkstat = "OFF"
ENDIF
m.compstat = SET("COMPATIBLE")
SET COMPATIBLE FOXPLUS

*       ÖÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ·
*       º                                                         º
*       º                MS-DOS Window definitions                º
*       º                                                         º
*       ÓÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ½
*

IF NOT WEXIST("backup") ;
	OR UPPER(WTITLE("BACKUP")) == "BACKUP.PJX" ;
	OR UPPER(WTITLE("BACKUP")) == "BACKUP.SCX" ;
	OR UPPER(WTITLE("BACKUP")) == "BACKUP.MNX" ;
	OR UPPER(WTITLE("BACKUP")) == "BACKUP.PRG" ;
	OR UPPER(WTITLE("BACKUP")) == "BACKUP.FRX" ;
	OR UPPER(WTITLE("BACKUP")) == "BACKUP.QPR"
	DEFINE WINDOW backup ;
		FROM INT((SROW()-19)/2),INT((SCOL()-77)/2) ;
		TO INT((SROW()-19)/2)+18,INT((SCOL()-77)/2)+76 ;
		NOFLOAT ;
		NOCLOSE ;
		SHADOW ;
		NOMINIMIZE ;
		DOUBLE ;
		COLOR SCHEME 1
ENDIF


*       ÖÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ·
*       º                                                         º
*       º          BACKUP/MS-DOS Setup Code - SECTION 2           º
*       º                                                         º
*       ÓÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ½
*

#REGION 1
close all
if not file("pkzip.exe")
	wait wind "PKZIP.EXE is not present. Backup not possible"
	return
endif
if not file("pkunzip.exe")
	wait wind "PKUNZIP.EXE is not present. Restore not possible"
	return
endif


*       ÖÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ·
*       º                                                         º
*       º               BACKUP/MS-DOS Screen Layout               º
*       º                                                         º
*       ÓÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ½
*

#REGION 1
IF WVISIBLE("backup")
	ACTIVATE WINDOW backup SAME
ELSE
	ACTIVATE WINDOW backup NOSHOW
ENDIF
@ 11,18 GET mchoice ;
	PICTURE "@*HN \<Backup;\<Restore;\<Exit" ;
	SIZE 1,11,1 ;
	DEFAULT 1 ;
	VALID MCHVLD()
@ 9,15 TO 13,55 DOUBLE
@ 0,11 SAY "RAMAKRISHNA MATH & RAMAKRISHNA MISSION, BELUR MATH" ;
	SIZE 1,50, 0
@ 2,26 SAY "VEHICLE DEPARTMENT" ;
	SIZE 1,18, 0
@ 4,20 SAY "BACKUP & RESTORE OF DATA FILES" ;
	SIZE 1,30, 0
@ 3,17 TO 5,52

IF NOT WVISIBLE("backup")
	ACTIVATE WINDOW backup
ENDIF

READ CYCLE

RELEASE WINDOW backup

#REGION 0
IF m.talkstat = "ON"
	SET TALK ON
ENDIF
IF m.compstat = "ON"
	SET COMPATIBLE ON
ENDIF


*       ÖÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ·
*       º                                                         º
*       º               BACKUP/MS-DOS Cleanup Code                º
*       º                                                         º
*       ÓÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ½
*

#REGION 1
quit

*       ÖÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ·
*       º                                                         º
*       º MCHVLD           mchoice VALID                          º
*       º                                                         º
*       º Function Origin:                                        º
*       º                                                         º
*       º From Platform:       MS-DOS                             º
*       º From Screen:         BACKUP,     Record Number:    2    º
*       º Variable:            mchoice                            º
*       º Called By:           VALID Clause                       º
*       º Object Type:         Push Button                        º
*       º Snippet Number:      1                                  º
*       º                                                         º
*       ÓÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ½
*
FUNCTION MCHVLD     &&  mchoice VALID
#REGION 1
do case
	case mchoice = 1
		wait wind 'Keep Backup disk in A drive and press any key'
		!pkzip a:\bkupveh *.dbf *.fpt *.mem
		wait wind 'Backup complete. Press any key to continue'
	case mchoice = 2
		wait wind 'Keep Backup disk in A drive and press any key'
		!pkunzip -o a:\bkupveh *.*
		wait wind 'Restore complete. Press any key to continue'
	case mchoice = 3
endcase
clear read
return

	
	